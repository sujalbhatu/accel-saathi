# Copy this file to .env and fill in your key. .env is git-ignored.
# Any OpenAI-compatible provider works. Without a key the app still runs (rules-only advisor).

# Google Gemini (free tier from https://aistudio.google.com/apikey)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash

# Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
# xAI:    LLM_BASE_URL=https://api.x.ai/v1               LLM_MODEL=grok-3-mini
# OpenAI: LLM_BASE_URL=https://api.openai.com/v1         LLM_MODEL=gpt-4o-mini
